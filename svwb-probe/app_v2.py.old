#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
控制台 —— 统一启动「悬浮层 / 战绩面板 / 开战判定」，并**分开**设置两者。

设计要点（按用户要求）：
  · **胜率悬浮层** 和 **战绩面板** 是两个独立窗口、两套独立设置
  · 控制台给它们**各自一个设置按钮**，互不干扰
  · 每个设置窗只改自己的参数，应用时只重启**自己那一个**进程

窗口对应关系：
  「胜率设置」→ overlay.py（悬浮层）+ 开战判定参数（等待秒数）
  「战绩设置」→ panel_ui.py（战绩面板）
"""
import json
import os
import subprocess
import sys
import time
import tkinter as tk
import tkinter.font as tkfont

import cleanup

HERE = os.path.dirname(os.path.abspath(__file__))
PKG = os.path.dirname(HERE)
GAME = os.path.join(PKG, "dsh-shadowverse-huanjing")
TOOLS = os.path.join(GAME, "tools")
LIVE = os.path.join(GAME, "shots", "live")
LOGS = os.path.join(HERE, "logs")
for _p in (LIVE, LOGS, os.path.join(HERE, "hero-portraits")):
    os.makedirs(_p, exist_ok=True)

OVERLAY_SET = os.path.join(LIVE, "overlay-settings.json")
PANEL_SET = os.path.join(LOGS, "panel-settings.json")
JUDGE_SET = os.path.join(LOGS, "judge-settings.json")

PY = sys.executable

BG = "#12161d"
BG2 = "#171c25"
FG = "#efe9dc"
GOLD = "#c9a86a"
GOLD2 = "#8d7a52"
DIM = "#9aa7a0"
RULE = "#2a3038"
GREEN = "#8fbf8a"
RED = "#c07b6b"

DEFAULT_OVERLAY = {"mode": "static", "alpha": 0.90, "scale": 1.0,
                   "titleColor": "#c9a86a", "interval": 0.6, "settle": 0.25,
                   "locked": False, "level": 3, "forceTopmost": True}
DEFAULT_PANEL = {"alpha": 0.88, "locked": False, "scale": 1.0,
                 "hero_display": "both", "force_topmost": True}
DEFAULT_JUDGE = {"delay": 1.5, "static": True}


def load_json(p, default):
    try:
        with open(p, encoding="utf-8") as fh:
            raw = json.load(fh) or {}
        out = dict(default)
        out.update(raw)
        return out
    except Exception:
        return dict(default)


def save_json(p, d):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w", encoding="utf-8") as fh:
        json.dump(d, fh, ensure_ascii=False, indent=1)


class SettingsDialog:
    """通用设置窗骨架：自带样式与底部按钮"""

    def __init__(self, master, title, width=400, height=430):
        self.w = tk.Toplevel(master)
        self.w.title(title)
        self.w.configure(bg=BG)
        self.w.geometry(f"{width}x{height}+140+120")
        self.w.transient(master)
        self.w.resizable(False, False)
        self.f_t = tkfont.Font(family="Microsoft YaHei UI", size=10, weight="bold")
        self.f_s = tkfont.Font(family="Microsoft YaHei UI", size=9)
        tk.Label(self.w, text=title, bg=BG, fg=GOLD, font=self.f_t).pack(pady=(10, 4))
        tk.Frame(self.w, bg=RULE, height=1).pack(fill="x", padx=16)
        self.body = tk.Frame(self.w, bg=BG)
        self.body.pack(fill="both", expand=True, padx=16, pady=6)
        self.vars = {}

    def section(self, title):
        tk.Label(self.body, text=title, bg=BG, fg=GOLD2, font=self.f_s,
                 anchor="w").pack(fill="x", pady=(8, 1))
        tk.Frame(self.body, bg=RULE, height=1).pack(fill="x")

    def slider(self, label, key, lo, hi, step, init, fmt="{:.2f}"):
        row = tk.Frame(self.body, bg=BG)
        row.pack(fill="x", pady=3)
        tk.Label(row, text=label, bg=BG, fg=FG, font=self.f_s, width=13,
                 anchor="w").pack(side="left")
        v = tk.DoubleVar(value=float(init))
        self.vars[key] = v
        val = tk.Label(row, text=fmt.format(float(init)), bg=BG, fg=GOLD2,
                       font=self.f_s, width=6, anchor="e")
        val.pack(side="right")
        tk.Scale(row, from_=lo, to=hi, resolution=step, orient="horizontal",
                 variable=v, showvalue=False, bg=BG, fg=FG, troughcolor=BG2,
                 highlightthickness=0, bd=0, sliderrelief="flat",
                 command=lambda _x: val.config(text=fmt.format(v.get()))
                 ).pack(side="left", fill="x", expand=True, padx=6)

    def check(self, label, key, init):
        v = tk.BooleanVar(value=bool(init))
        self.vars[key] = v
        tk.Checkbutton(self.body, text=label, variable=v, bg=BG, fg=FG,
                       selectcolor=BG2, activebackground=BG, activeforeground=FG,
                       font=self.f_s, highlightthickness=0).pack(anchor="w")
        return v

    def radio_row(self, label, key, init, options):
        row = tk.Frame(self.body, bg=BG)
        row.pack(fill="x", pady=2)
        tk.Label(row, text=label, bg=BG, fg=FG, font=self.f_s, width=13,
                 anchor="w").pack(side="left")
        v = tk.StringVar(value=init)
        self.vars[key] = v
        for val, lab in options:
            tk.Radiobutton(row, text=lab, variable=v, value=val, bg=BG, fg=DIM,
                           selectcolor=BG2, activebackground=BG,
                           activeforeground=FG, font=self.f_s,
                           highlightthickness=0).pack(side="left")
        return v

    def buttons(self, on_apply):
        tk.Frame(self.w, bg=RULE, height=1).pack(fill="x", padx=16, pady=(6, 0))
        bar = tk.Frame(self.w, bg=BG)
        bar.pack(fill="x", padx=16, pady=8)
        tk.Button(bar, text="应用并重启", command=on_apply, bg=GOLD, fg="#1a1209",
                  relief="flat", bd=0, padx=12, pady=5, font=self.f_s,
                  cursor="hand2").pack(side="right")
        tk.Button(bar, text="取消", command=self.w.destroy, bg=BG2, fg=DIM,
                  relief="flat", bd=0, padx=12, pady=5, font=self.f_s,
                  cursor="hand2").pack(side="right", padx=6)


class App:
    def __init__(self, root):
        self.root = root
        self.procs = {}
        self.labels = {}
        self._last_sweep = 0

        root.title("影之幻境 · 控制台")
        root.configure(bg=BG)
        root.geometry("380x500+80+80")
        root.resizable(False, False)

        self.f_t = tkfont.Font(family="Microsoft YaHei UI", size=10, weight="bold")
        self.f_s = tkfont.Font(family="Microsoft YaHei UI", size=9)

        tk.Label(root, text="影  之  幻  境", bg=BG, fg=GOLD,
                 font=self.f_t).pack(pady=(12, 2))
        tk.Label(root, text="v0.1.0  控制台", bg=BG, fg=GOLD2, font=self.f_s).pack()
        tk.Frame(root, bg=RULE, height=1).pack(fill="x", padx=24, pady=8)

        # 两个独立分组，各带「设置」按钮
        self._group("胜率悬浮层", "overlay", self.open_overlay_settings)
        self._group("战绩面板", "panel", self.open_panel_settings)

        tk.Frame(root, bg=RULE, height=1).pack(fill="x", padx=24, pady=10)
        row = tk.Frame(root, bg=BG)
        row.pack(fill="x", padx=20)
        for text, cmd, color in (("全部启动", self.start_all, GOLD),
                                 ("重启全部", self.restart_all, GOLD2),
                                 ("退出全部", self.stop_all, RED)):
            tk.Button(row, text=text, command=cmd, bg=BG2, fg=color,
                      activebackground=BG2, relief="flat", bd=0, padx=8, pady=6,
                      font=self.f_s, cursor="hand2").pack(side="left", fill="x",
                                                          expand=True, padx=2)

        tk.Frame(root, bg=RULE, height=1).pack(fill="x", padx=24, pady=8)
        tk.Label(root, text="面板右上角 🔓/🔒 可单独锁定\n"
                            "锁定后点击穿透，不挡游戏操作\n"
                            "截图超过 2 小时自动清理",
                 bg=BG, fg=GOLD2, font=self.f_s, justify="left").pack(
            anchor="w", padx=26)

        try:
            n, b = cleanup.sweep()
            if n:
                print(f"启动清理：删除 {n} 个超期截图，释放 {b/1048576:.1f} MB")
        except Exception:
            pass

        self._tick()
        self.start_all()

    def _group(self, label, key, settings_cmd):
        box = tk.Frame(self.root, bg=BG2)
        box.pack(fill="x", padx=20, pady=4)
        left = tk.Frame(box, bg=BG2)
        left.pack(side="left", fill="x", expand=True, padx=8, pady=6)
        tk.Label(left, text=label, bg=BG2, fg=FG, font=self.f_s,
                 anchor="w").pack(fill="x")
        lbl = tk.Label(left, text="状态：—", bg=BG2, fg=DIM, font=self.f_s,
                       anchor="w")
        lbl.pack(fill="x")
        self.labels[key] = lbl

        right = tk.Frame(box, bg=BG2)
        right.pack(side="right", padx=8, pady=6)
        tk.Button(right, text="设置", command=settings_cmd, bg=BG, fg=GOLD,
                  relief="flat", bd=0, padx=12, pady=5, font=self.f_s,
                  cursor="hand2").pack(side="right")
        tk.Button(right, text="重启", command=lambda: self.restart_one(key),
                  bg=BG, fg=DIM, relief="flat", bd=0, padx=8, pady=5,
                  font=self.f_s, cursor="hand2").pack(side="right", padx=4)

    # ---------------- 进程 ----------------
    def _spawn(self, key, args, cwd):
        self._kill(key)
        os.makedirs(LOGS, exist_ok=True)
        out = open(os.path.join(LOGS, f"{key}-out.txt"), "a", encoding="utf-8",
                   errors="replace")
        err = open(os.path.join(LOGS, f"{key}-err.txt"), "a", encoding="utf-8",
                   errors="replace")
        try:
            self.procs[key] = subprocess.Popen(
                [PY, "-u"] + args, cwd=cwd, stdout=out, stderr=err,
                creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
        except Exception as e:
            print(f"启动 {key} 失败: {e}")

    def _kill(self, key):
        p = self.procs.pop(key, None)
        if p and p.poll() is None:
            try:
                p.terminate()
                p.wait(timeout=3)
            except Exception:
                try:
                    p.kill()
                except Exception:
                    pass

    def _cmd_for(self, key):
        if key == "overlay":
            return [os.path.join(TOOLS, "overlay.py")], GAME
        if key == "panel":
            return [os.path.join(HERE, "panel_ui.py")], HERE
        delay = str(load_json(JUDGE_SET, DEFAULT_JUDGE).get("delay", 1.5))
        return ([os.path.join(HERE, "watch_mem.py"),
                 "--timeout", "10800", "--delay", delay], HERE)

    def start_one(self, key, pause=0.0):
        args, cwd = self._cmd_for(key)
        if pause:
            time.sleep(pause)
        self._spawn(key, args, cwd)
        self._update_status()

    def restart_one(self, key):
        self._kill(key)
        self.start_one(key)

    def start_all(self):
        self.start_one("overlay")
        self.start_one("panel", pause=1.0)
        self.start_one("judge", pause=0.5)

    def restart_all(self):
        self.stop_all()
        time.sleep(1.0)
        self.start_all()

    def stop_all(self):
        for k in ("overlay", "panel", "judge"):
            self._kill(k)
        self._update_status()

    def _update_status(self):
        for key, lbl in self.labels.items():
            p = self.procs.get(key)
            alive = bool(p and p.poll() is None)
            lbl.config(text="状态：" + ("运行中" if alive else "已停止"),
                       fg=GREEN if alive else RED)

    def _tick(self):
        self._update_status()
        now = time.time()
        if now - self._last_sweep > 600:
            self._last_sweep = now
            try:
                n, b = cleanup.sweep()
                if n:
                    print(f"定时清理：删除 {n} 个超期截图，释放 {b/1048576:.1f} MB")
            except Exception:
                pass
        self.root.after(2000, self._tick)

    # ---------------- 两个独立设置窗 ----------------
    def open_overlay_settings(self):
        ov = load_json(OVERLAY_SET, DEFAULT_OVERLAY)
        jd = load_json(JUDGE_SET, DEFAULT_JUDGE)
        dlg = SettingsDialog(self.root, "胜率悬浮层 · 设置", 400, 440)

        dlg.section("悬浮层")
        dlg.slider("不透明度", "ov_alpha", 0.3, 1.0, 0.02, ov["alpha"])
        dlg.slider("缩放", "ov_scale", 0.8, 1.6, 0.05, ov["scale"])
        dlg.check("强制置顶（压在游戏之上）", "ov_top",
                  ov.get("forceTopmost", True))
        dlg.check("锁定（点击穿透）", "ov_locked", ov.get("locked", False))

        dlg.section("开战判定")
        dlg.slider("开战等待(秒)", "delay", 0.5, 3.0, 0.1, jd.get("delay", 1.5),
                   "{:.1f}")
        dlg.check("只在开战瞬间算一次", "static", jd.get("static", True))

        def apply():
            ov["alpha"] = round(dlg.vars["ov_alpha"].get(), 2)
            ov["scale"] = round(dlg.vars["ov_scale"].get(), 2)
            ov["forceTopmost"] = bool(dlg.vars["ov_top"].get())
            ov["locked"] = bool(dlg.vars["ov_locked"].get())
            save_json(OVERLAY_SET, ov)
            jd["delay"] = round(dlg.vars["delay"].get(), 1)
            jd["static"] = bool(dlg.vars["static"].get())
            save_json(JUDGE_SET, jd)
            dlg.w.destroy()
            self.restart_one("overlay")
            self.restart_one("judge")

        dlg.buttons(apply)

    def open_panel_settings(self):
        pn = load_json(PANEL_SET, DEFAULT_PANEL)
        dlg = SettingsDialog(self.root, "战绩面板 · 设置", 400, 400)

        dlg.section("战绩面板")
        dlg.slider("不透明度", "pn_alpha", 0.3, 1.0, 0.02, pn["alpha"])
        dlg.slider("面板尺寸", "pn_scale", 0.6, 2.0, 0.05, pn.get("scale", 1.0))
        dlg.radio_row("主战者显示", "hero_display",
                      pn.get("hero_display", "both"),
                      (("both", "头像+名字"), ("name", "仅名字"),
                       ("portrait", "仅头像")))
        dlg.check("强制置顶（压在游戏之上）", "pn_top",
                  pn.get("force_topmost", True))
        dlg.check("锁定（点击穿透）", "pn_locked", pn.get("locked", False))

        def apply():
            pn["alpha"] = round(dlg.vars["pn_alpha"].get(), 2)
            pn["scale"] = round(dlg.vars["pn_scale"].get(), 2)
            pn["hero_display"] = dlg.vars["hero_display"].get()
            pn["force_topmost"] = bool(dlg.vars["pn_top"].get())
            pn["locked"] = bool(dlg.vars["pn_locked"].get())
            save_json(PANEL_SET, pn)
            dlg.w.destroy()
            self.restart_one("panel")

        dlg.buttons(apply)

    def on_close(self):
        self.stop_all()
        self.root.destroy()


def main():
    root = tk.Tk()
    app = App(root)
    root.protocol("WM_DELETE_WINDOW", app.on_close)
    root.mainloop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
