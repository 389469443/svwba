#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
历史上方面板 —— 显示这一整局（从启动到关闭）的每场战绩。

内容：
    · 场次、时间
    · 我方阵容（星级/攻血/卡名）+ 等级、血量
    · 对方阵容
    · 预测胜率
    · **实际掉血**（用下一场开战时的血量差反推，不需要人工输入）
    · 整局名次（能读到就显示）

操作：
    双击标题栏可拖动；右上角 ✕ 关闭；「刷新」手动重载；每 3 秒自动刷新。
    行可点击展开/收起对方阵容。

用法：
    python history_panel.py
"""
import json
import os
import sys
import tkinter as tk

HERE = os.path.dirname(os.path.abspath(__file__))
HIST = os.path.join(HERE, "logs", "history.json")

BG = "#12161d"
BG2 = "#171c25"
FG = "#efe9dc"
GOLD = "#c9a86a"
GOLD2 = "#8d7a52"
DIM = "#9aa7a0"
RULE = "#2a3038"
GREEN = "#8fbf8a"
RED = "#c07b6b"


class Panel:
    def __init__(self, root):
        self.root = root
        self.expanded = set()
        self.last_sig = None
        root.title("影之幻境 · 战绩")
        root.configure(bg=BG)
        sw = root.winfo_screenwidth()
        sh = root.winfo_screenheight()
        w, h = min(560, int(sw * 0.40)), min(680, int(sh * 0.72))
        root.geometry(f"{w}x{h}+{int(sw*0.62)}+60")
        root.minsize(520, 360)

        # 顶部
        head = tk.Frame(root, bg=BG)
        head.pack(fill="x", padx=14, pady=(12, 6))
        tk.Label(head, text="影  之  幻  境  ·  战  绩", bg=BG, fg=GOLD,
                 font=("Microsoft YaHei UI", 11, "bold")).pack(side="left")
        tk.Button(head, text="刷新", command=self.refresh,
                  bg=BG2, fg=DIM, relief="flat", bd=0, padx=10,
                  font=("Microsoft YaHei UI", 9),
                  activebackground=BG2).pack(side="right")
        self.info = tk.Label(root, text="", bg=BG, fg=GOLD2, anchor="w",
                             font=("Microsoft YaHei UI", 9))
        self.info.pack(fill="x", padx=16)
        tk.Frame(root, bg=RULE, height=1).pack(fill="x", padx=12, pady=(8, 0))

        # 滚动区
        wrap = tk.Frame(root, bg=BG)
        wrap.pack(fill="both", expand=True, padx=12, pady=8)
        self.canvas = tk.Canvas(wrap, bg=BG, highlightthickness=0)
        sb = tk.Scrollbar(wrap, orient="vertical", command=self.canvas.yview)
        self.body = tk.Frame(self.canvas, bg=BG)
        self.body.bind("<Configure>",
                       lambda e: self.canvas.configure(scrollregion=self.canvas.bbox("all")))
        self.win = self.canvas.create_window((0, 0), window=self.body, anchor="nw")
        self.canvas.configure(yscrollcommand=sb.set)
        self.canvas.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")
        self.canvas.bind("<Configure>",
                         lambda e: self.canvas.itemconfig(self.win, width=e.width))
        self.canvas.bind_all("<MouseWheel>", self._wheel)

        self.refresh()
        self.root.after(3000, self._tick)

    def _wheel(self, e):
        self.canvas.yview_scroll(int(-e.delta / 120), "units")

    def _tick(self):
        self.refresh()
        self.root.after(3000, self._tick)

    def _load(self):
        try:
            with open(HIST, encoding="utf-8") as fh:
                return json.load(fh)
        except Exception:
            return {"records": []}

    def refresh(self):
        d = self._load()
        recs = d.get("records") or []
        sig = (len(recs), d.get("placement"), tuple(r.get("actual_me") for r in recs))
        if sig == self.last_sig:
            return
        self.last_sig = sig

        place = d.get("placement")
        sess = d.get("session", "?")
        self.info.config(
            text=f"开局 {sess}    共 {len(recs)} 场    "
                 f"名次：{('第 ' + str(place) + ' 名') if place else '进行中'}")

        for w in self.body.winfo_children():
            w.destroy()

        if not recs:
            tk.Label(self.body, text="还没有记录，开一局试试喵",
                     bg=BG, fg=GOLD2,
                     font=("Microsoft YaHei UI", 10)).pack(pady=30)
            return

        for i, r in enumerate(recs, 1):
            self._row(i, r)

    def _row(self, idx, r):
        f = tk.Frame(self.body, bg=BG)
        f.pack(fill="x", pady=3)
        tk.Frame(f, bg=RULE, height=1).pack(fill="x")

        head = tk.Frame(f, bg=BG)
        head.pack(fill="x", pady=4)

        win, loss, draw = r.get("win", 0), r.get("loss", 0), r.get("draw", 0)
        col = GREEN if win >= 50 else (RED if loss >= 50 else DIM)
        tk.Label(head, text=f"第{idx}把  {r['t']}", bg=BG, fg=GOLD,
                 font=("Microsoft YaHei UI", 9, "bold")).pack(side="left")
        tk.Label(head, text=f"  胜{win}% 败{loss}% 平{draw}%",
                 bg=BG, fg=col,
                 font=("Microsoft YaHei UI", 9, "bold")).pack(side="left")

        act = []
        if r.get("actual_me"):
            act.append(f"实掉 {r['actual_me']}")
        if r.get("actual_opp"):
            act.append(f"敌掉 {r['actual_opp']}")
        if act:
            tk.Label(head, text="  " + "  ".join(act), bg=BG, fg=DIM,
                     font=("Microsoft YaHei UI", 9)).pack(side="left")

        # 阵容摘要
        def brief(board):
            return "  ".join(f"{c['star']}★{c['attack']}/{c['health']}"
                             for c in board) or "（空）"

        # 用户要求：**只显示自己的信息**，不显示对方
        import history as HIS
        mh, mp = HIS.hero_name(r.get("me_hero") or 0)
        me_tag = mh + (f"·{mp}" if mp else "")

        line = tk.Frame(f, bg=BG)
        line.pack(fill="x")
        tk.Label(line, text=f"主战者 {me_tag}    Lv{r['me_lv']}    血 {r['me_hp']}",
                 bg=BG, fg=GOLD, anchor="w", justify="left",
                 font=("Microsoft YaHei UI", 9, "bold")).pack(fill="x")
        tk.Label(line, text=f"阵容  {brief(r['me_board'])}",
                 bg=BG, fg=FG, anchor="w", justify="left",
                 font=("Microsoft YaHei UI", 9)).pack(fill="x")


def main():
    root = tk.Tk()
    Panel(root)
    root.mainloop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
