#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
战绩面板 —— 与悬浮层同风格：透明、可锁定、可拖动。

视觉：深墨蓝半透明底板 + 香槟金细边 + 象牙白字（与悬浮层一致）
窗口：无边框 + 抠色透明 + 半透明 alpha
锁定：点右上角 🔓/🔒 或双击面板
      · 未锁定 → 可拖动
      · 已锁定 → 点击穿透，不挡游戏操作

内容（**只显示你自己**）：
    第 N 把   时间   胜率   实掉X
    主战者·职业   Lv等级  血X
    阵容 4★3/3 2★1/1 ...
顶部：开局时间、场次、名次
"""
import json
import os
import sys
import tkinter as tk
import tkinter.font as tkfont

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)

HIST = os.path.join(HERE, "logs", "history.json")
POSF = os.path.join(HERE, "logs", "panel-pos.json")
PANEL_SET = os.path.join(HERE, "logs", "panel-settings.json")
# 主战者立绘缓存目录：<heroId>.png / .webp，有就显示头像
HERO_DIR = os.path.join(HERE, "hero-portraits")

CHROMA = "#010203"
BG = "#12161d"
BORDER = "#3a3a44"
FG = "#efe9dc"
GOLD = "#c9a86a"
GOLD2 = "#8d7a52"
DIM = "#9aa7a0"
RULE = "#2a3038"
GREEN = "#8fbf8a"
RED = "#c07b6b"
ALPHA = 0.88

WIN_W, WIN_H = 300, 340
# 实际尺寸 = 基准 × scale（控制台可调）      # 逻辑像素（175% 缩放 → 物理约 553x663）

GWL_EXSTYLE = -20
WS_EX_LAYERED = 0x00080000
WS_EX_TRANSPARENT = 0x00000020
WS_EX_TOPMOST = 0x00000008
WS_EX_TOOLWINDOW = 0x00000080
HWND_TOPMOST = -1
SWP_NOMOVE, SWP_NOSIZE, SWP_NOACTIVATE = 0x0002, 0x0001, 0x0010


def load_pos():
    try:
        with open(POSF, encoding="utf-8") as fh:
            d = json.load(fh)
        return int(d["x"]), int(d["y"]), bool(d.get("locked"))
    except Exception:
        return None, None, False


def save_pos(x, y, locked):
    try:
        os.makedirs(os.path.dirname(POSF), exist_ok=True)
        with open(POSF, "w", encoding="utf-8") as fh:
            json.dump({"x": x, "y": y, "locked": locked}, fh)
    except Exception:
        pass


class Panel:
    def __init__(self, root):
        self.root = root
        self.last_sig = None
        self.locked = False
        self._drag = None
        self.pos = [None, None]

        root.title("影之幻境 · 战绩")
        root.overrideredirect(True)
        root.attributes("-topmost", True)
        # 调试开关：PANEL_OPAQUE=1 时关闭透明，用于截图排查"看不见"
        _opaque = os.environ.get("PANEL_OPAQUE") == "1"
        if not _opaque:
            try:
                root.attributes("-transparentcolor", CHROMA)
            except Exception:
                pass
            try:
                root.attributes("-alpha", ALPHA)
            except Exception:
                pass
        root.configure(bg=CHROMA)

        # 尺寸由设置的 scale 决定
        try:
            with open(PANEL_SET, encoding="utf-8") as _fh:
                _sc = float((json.load(_fh) or {}).get("scale") or 1.0)
        except Exception:
            _sc = 1.0
        _sc = max(0.6, min(2.0, _sc))
        global WIN_W, WIN_H
        WIN_W, WIN_H = int(300 * _sc), int(340 * _sc)
        self._scale = _sc

        sw = root.winfo_screenwidth()
        sh = root.winfo_screenheight()
        x, y, locked = load_pos()

        # 钳制到屏幕可见范围：之前存过越界坐标（y 变成负数），
        # 窗口跑到屏幕上方，用户就"看不到面板"了。
        def _clamp(v, lo, hi):
            return max(lo, min(hi, v))

        if x is None or y is None:
            x, y = sw - WIN_W - 30, 90
        x = _clamp(x, 0, max(0, sw - WIN_W))
        y = _clamp(y, 0, max(0, sh - WIN_H))
        self.pos = [x, y]
        self.locked = locked
        root.geometry(f"{WIN_W}x{WIN_H}+{x}+{y}")

        # 外层**完全透明**（用抠色键），只有内层内容区是深色底板。
        # 这样面板看起来是"一块内容浮在游戏上"，而不是一个实心方框。
        self.frame = tk.Frame(root, bg=CHROMA, highlightthickness=0, bd=0)
        self.frame.pack(fill="both", expand=True)
        self.pad = tk.Frame(self.frame, bg=BG)
        self.pad.pack(fill="both", expand=True, padx=4, pady=4)

        self.f_t = tkfont.Font(family="Microsoft YaHei UI", size=max(7, int(8*_sc)), weight="bold")
        self.f_s = tkfont.Font(family="Microsoft YaHei UI", size=max(6, int(7*_sc)))

        head = tk.Frame(self.pad, bg=BG)
        head.pack(fill="x")
        self.title = tk.Label(head, text="战　绩", bg=BG, fg=GOLD,
                              font=self.f_t, anchor="w")
        self.title.pack(side="left")
        self.lock_btn = tk.Button(head, text="🔓", command=self._toggle_lock,
                                  bg=BG, fg=GOLD2, relief="flat", bd=0,
                                  padx=4, font=self.f_s, activebackground=BG,
                                  cursor="hand2")
        self.lock_btn.pack(side="right")

        self.info = tk.Label(self.pad, text="", bg=BG, fg=GOLD2, anchor="w",
                             font=self.f_s, wraplength=WIN_W - 26, justify="left")
        self.info.pack(fill="x", pady=(2, 0))
        tk.Frame(self.pad, bg=RULE, height=1).pack(fill="x", pady=(4, 2))

        wrap = tk.Frame(self.pad, bg=BG)
        wrap.pack(fill="both", expand=True)
        self.canvas = tk.Canvas(wrap, bg=BG, highlightthickness=0, width=WIN_W - 30)
        self.sb = tk.Scrollbar(wrap, orient="vertical", command=self.canvas.yview)
        self.body = tk.Frame(self.canvas, bg=BG)
        self.body.bind("<Configure>", lambda e: self.canvas.configure(
            scrollregion=self.canvas.bbox("all")))
        self.win = self.canvas.create_window((0, 0), window=self.body, anchor="nw")
        self.canvas.configure(yscrollcommand=self.sb.set)
        self.canvas.pack(side="left", fill="both", expand=True)
        self.sb.pack(side="right", fill="y")
        self.canvas.bind("<Configure>", lambda e: self.canvas.itemconfig(
            self.win, width=e.width))
        self.canvas.bind_all("<MouseWheel>",
                             lambda e: self.canvas.yview_scroll(int(-e.delta / 120), "units"))

        for w in (root, self.frame, self.pad, self.title, self.info, self.canvas):
            w.bind("<Button-1>", self._on_press)
            w.bind("<B1-Motion>", self._on_drag)
            w.bind("<ButtonRelease-1>", self._on_release)
            w.bind("<Double-Button-1>", self._toggle_lock)

        self._alpha = ALPHA
        self.hero_display = "both"
        self.force_topmost = True
        self._apply_settings()
        self.refresh()
        self._apply_style()
        self._refresh_look()
        root.update_idletasks()
        root.geometry(f"{WIN_W}x{WIN_H}+{x}+{y}")
        root.after(150, lambda: root.geometry(
            f"{WIN_W}x{WIN_H}+{self.pos[0]}+{self.pos[1]}"))
        root.after(3000, self._tick)
        root.after(300, self._keep_topmost)

    def _on_press(self, e):
        if self.locked:
            return
        self._drag = (e.x_root, e.y_root, self.pos[0], self.pos[1])

    def _on_drag(self, e):
        """
        拖动时**限制在屏幕内**。

        之前不限制，拖到屏幕上方后会保存负坐标，
        下次启动窗口直接跑到屏幕外 —— 表现就是"面板不见了"。
        """
        if self.locked or not self._drag:
            return
        x0, y0, px, py = self._drag
        nx, ny = px + (e.x_root - x0), py + (e.y_root - y0)
        sw = self.root.winfo_screenwidth()
        sh = self.root.winfo_screenheight()
        # 至少留 60px 在屏幕内，避免整块拖出去
        nx = max(-(WIN_W - 60), min(sw - 60, nx))
        ny = max(0, min(sh - 60, ny))
        self.pos = [nx, ny]
        self.root.geometry(f"+{nx}+{ny}")

    def _on_release(self, _e):
        if self.locked:
            return
        self._drag = None
        save_pos(self.pos[0], self.pos[1], self.locked)

    def _toggle_lock(self, _e=None):
        self.locked = not self.locked
        self._apply_style()
        self._refresh_look()
        save_pos(self.pos[0], self.pos[1], self.locked)
        print("战绩面板：" + ("已锁定（点击穿透）" if self.locked else "已解锁（可拖动）"))
        return "break"

    def _hwnd(self):
        import ctypes
        return (ctypes.windll.user32.GetParent(self.root.winfo_id())
                or self.root.winfo_id())

    def _apply_style(self):
        try:
            import ctypes
            user32 = ctypes.windll.user32
            hwnd = self._hwnd()
            ex = user32.GetWindowLongW(hwnd, GWL_EXSTYLE)
            ex |= WS_EX_LAYERED | WS_EX_TOOLWINDOW
            if self.force_topmost:
                ex |= WS_EX_TOPMOST
            else:
                ex &= ~WS_EX_TOPMOST
            if self.locked:
                ex |= WS_EX_TRANSPARENT
            else:
                ex &= ~WS_EX_TRANSPARENT
            user32.SetWindowLongW(hwnd, GWL_EXSTYLE, ex)
            if self.force_topmost:
                user32.SetWindowPos(hwnd, HWND_TOPMOST, 0, 0, 0, 0,
                                    SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE)
        except Exception as e:
            print(f"（设置窗口样式失败：{e}）")

    def _refresh_look(self):
        self.title.config(fg=GOLD if not self.locked else GOLD2)
        self.lock_btn.config(text="🔒" if self.locked else "🔓")

    def _apply_settings(self):
        """
        读控制台写的设置文件（不透明度 / 锁定）。

        控制台「应用并重启」会先写这个文件再重启本进程，所以这里读一次就够；
        但为了支持不重启直接生效，也在 _tick 里轮询。
        """
        try:
            with open(PANEL_SET, encoding="utf-8") as fh:
                d = json.load(fh) or {}
        except Exception:
            return
        a = d.get("alpha")
        if isinstance(a, (int, float)) and abs(a - getattr(self, "_alpha", ALPHA)) > 0.005:
            self._alpha = float(a)
            try:
                self.root.attributes("-alpha", self._alpha)
            except Exception:
                pass
        ft = d.get("force_topmost")
        if isinstance(ft, bool):
            self.force_topmost = ft
        hd = d.get("hero_display")
        if hd in ("name", "portrait", "both"):
            self.hero_display = hd
        lk = d.get("locked")
        if isinstance(lk, bool) and lk != self.locked:
            self.locked = lk
            self._apply_style()
            self._refresh_look()

    def _tick(self):
        self._apply_settings()
        self.refresh()
        self.root.after(3000, self._tick)

    def _keep_topmost(self):
        """
        每 300ms 重新置顶一次。

        ⚠️ 为什么要这么频繁：游戏是无边框全屏（2560x1600 铺满屏幕），
        它自己也是置顶窗口，而且会反复把自己顶回来。两个置顶窗口谁最后
        置顶谁在上面，所以必须**高频抢**，否则面板会被游戏盖住
        （实测：不抢的话 WindowFromPoint 返回的是游戏窗口）。
        """
        if self.force_topmost:
            try:
                import ctypes
                user32 = ctypes.windll.user32
                hwnd = self._hwnd()
                user32.SetWindowPos(hwnd, HWND_TOPMOST, 0, 0, 0, 0,
                                    SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE)
            except Exception:
                pass
        self.root.after(300, self._keep_topmost)

    def _load(self):
        try:
            with open(HIST, encoding="utf-8") as fh:
                return json.load(fh)
        except Exception:
            return {"records": []}

    def refresh(self):
        d = self._load()
        recs = d.get("records") or []
        sig = (len(recs), d.get("placement"),
               tuple(r.get("actual_me") for r in recs))
        if sig == self.last_sig:
            return
        self.last_sig = sig

        place = d.get("placement")
        parts = [f"开局 {d.get('session', '?')}", f"{len(recs)} 场"]
        parts.append(f"名次 第{place}名" if place else "名次 进行中")
        self.info.config(text="   ".join(parts))

        for w in self.body.winfo_children():
            w.destroy()
        if not recs:
            tk.Label(self.body, text="还没有记录，开一局试试喵", bg=BG, fg=GOLD2,
                     font=self.f_s).pack(pady=18)
            return
        for i, r in enumerate(recs, 1):
            self._row(i, r)

    def _row(self, idx, r):
        import history as HIS
        f = tk.Frame(self.body, bg=BG)
        f.pack(fill="x", pady=2)

        head = tk.Frame(f, bg=BG)
        head.pack(fill="x")
        win, loss = r.get("win", 0), r.get("loss", 0)
        col = GREEN if win >= 50 else (RED if loss >= 50 else DIM)
        tk.Label(head, text=f"第{idx}把", bg=BG, fg=GOLD,
                 font=self.f_t).pack(side="left")
        tk.Label(head, text=f" {r['t']} 胜{win}%", bg=BG, fg=col,
                 font=self.f_s).pack(side="left")
        if r.get("actual_me"):
            tk.Label(head, text=f" 实掉{r['actual_me']}", bg=BG, fg=DIM,
                     font=self.f_s).pack(side="left")

        name, prof = HIS.hero_name(r.get("me_hero") or 0)
        tag = name + (f"·{prof}" if prof else "")
        head2 = tk.Frame(f, bg=BG)
        head2.pack(fill="x")

        # 主战者显示方式：名字 / 头像 / 两者（设置里可切换）
        mode = getattr(self, "hero_display", "both")
        hero_id = r.get("me_hero") or 0
        if mode in ("portrait", "both"):
            px = int(34 * getattr(self, "_scale", 1.0))
            ph = self._hero_portrait(hero_id, px)
            if ph is not None:
                keep = getattr(self, "_photo_refs", [])
                keep.append(ph)
                self._photo_refs = keep[-40:]      # 防止被回收
                lbl = tk.Label(head2, image=ph, bg=BG, bd=0)
                lbl.image = ph
                lbl.pack(side="left", padx=(0, 5))
            else:
                # 没有立绘 → 用小方块占位（避免布局跳动）
                tk.Label(head2, text="?", bg=BG2, fg=GOLD2,
                         width=3, height=2, font=self.f_s).pack(side="left",
                                                               padx=(0, 5))

        if mode in ("name", "both"):
            tk.Label(head2, text=f"{tag}  Lv{r['me_lv']} 血{r['me_hp']}",
                     bg=BG, fg=FG, anchor="w", justify="left",
                     font=self.f_s).pack(side="left")
        else:
            tk.Label(head2, text=f"Lv{r['me_lv']} 血{r['me_hp']}",
                     bg=BG, fg=DIM, anchor="w", font=self.f_s).pack(side="left")
        tk.Label(f, text=self._brief(r["me_board"]), bg=BG, fg=DIM,
                 anchor="w", justify="left", wraplength=WIN_W - 34,
                 font=self.f_s).pack(fill="x")

    def _hero_portrait(self, hero_id, px):
        """读缓存立绘并缩放到 px×px；没有就返回 None"""
        for ext in (".png", ".webp", ".jpg"):
            f = os.path.join(HERO_DIR, f"{hero_id}{ext}")
            if os.path.isfile(f):
                try:
                    from PIL import Image, ImageTk
                    im = Image.open(f).convert("RGB")
                    w, h = im.size
                    side = min(w, h)
                    im = im.crop(((w - side) // 2, 0, (w + side) // 2, side))
                    im = im.resize((px, px), Image.LANCZOS)
                    return ImageTk.PhotoImage(im)
                except Exception:
                    return None
        return None

    @staticmethod
    def _brief(board, limit=4):
        items = [f"{c['star']}★{c['attack']}/{c['health']}" for c in board]
        if not items:
            return "阵容 （空）"
        extra = f" +{len(items)-limit}" if len(items) > limit else ""
        return "阵容 " + " ".join(items[:limit]) + extra


def main():
    root = tk.Tk()
    Panel(root)
    root.mainloop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
