#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
控制台 —— 统一启动 / 设置 **悬浮层 + 战绩面板**。

为什么单独做这个：
  两个窗口本来各有各的入口，用户要分别启动、分别调参数，很麻烦。
  这里做成一个控制台：
    · 一键启动 / 重启 / 退出全部
    · 一个设置界面同时调两边（透明度、缩放、锁定）
    · 显示两个窗口的运行状态

实现方式：
  控制台本身是个普通小窗口，把 overlay.py 和 panel_ui.py 作为**子进程**拉起。
  「应用并重启」会先写设置文件，再重启子进程 —— 这样参数一定生效，
  不需要子进程自己热重载（更可靠）。
"""
import json
import os
import subprocess
import sys
import time
import tkinter as tk
import tkinter.font as tkfont

import cleanup

HERE = os.path.dirname(os.path.abspath(__file__))
PKG = os.path.dirname(HERE)
GAME = os.path.join(PKG, "dsh-shadowverse-huanjing")
TOOLS = os.path.join(GAME, "tools")
LIVE = os.path.join(GAME, "shots", "live")
os.makedirs(LIVE, exist_ok=True)

OVERLAY_SET = os.path.join(LIVE, "overlay-settings.json")
PANEL_SET = os.path.join(HERE, "logs", "panel-settings.json")
os.makedirs(os.path.dirname(PANEL_SET), exist_ok=True)

PY = sys.executable
BG = "#12161d"
BG2 = "#171c25"
FG = "#efe9dc"
GOLD = "#c9a86a"
GOLD2 = "#8d7a52"
DIM = "#9aa7a0"
RULE = "#2a3038"
GREEN = "#8fbf8a"
RED = "#c07b6b"


def load_json(p, default):
    try:
        with open(p, encoding="utf-8") as fh:
            d = json.load(fh)
        out = dict(default)
        out.update(d or {})
        return out
    except Exception:
        return dict(default)


def save_json(p, d):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w", encoding="utf-8") as fh:
        json.dump(d, fh, ensure_ascii=False, indent=1)


DEFAULT_OVERLAY = {"mode": "dynamic", "alpha": 0.90, "scale": 1.0,
                   "forceTopmost": True,
                   "titleColor": "#c9a86a", "interval": 0.6, "settle": 0.25,
                   "locked": False, "level": 3}
DEFAULT_PANEL = {"alpha": 0.88, "locked": False, "scale": 1.0,
                 "hero_display": "both", "force_topmost": True}


class App:
    def __init__(self, root):
        self.root = root
        self.procs = {}
        root.title("影之幻境 · 控制台")
        root.configure(bg=BG)
        root.geometry("360x460+80+80")
        root.resizable(False, False)

        self.f_t = tkfont.Font(family="Microsoft YaHei UI", size=10, weight="bold")
        self.f_s = tkfont.Font(family="Microsoft YaHei UI", size=9)

        tk.Label(root, text="影  之  幻  境", bg=BG, fg=GOLD,
                 font=self.f_t).pack(pady=(12, 2))
        tk.Label(root, text="控制台", bg=BG, fg=GOLD2, font=self.f_s).pack()
        tk.Frame(root, bg=RULE, height=1).pack(fill="x", padx=20, pady=8)

        # 状态
        self.status = tk.Label(root, text="", bg=BG, fg=DIM, font=self.f_s,
                               justify="left", anchor="w")
        self.status.pack(fill="x", padx=20)

        # 按钮
        btns = tk.Frame(root, bg=BG)
        btns.pack(fill="x", padx=20, pady=10)
        self._btn(btns, "启动全部", self.start_all, GOLD)
        self._btn(btns, "重启全部", self.restart_all, GOLD2)
        self._btn(btns, "设置", self.open_settings, GOLD2)
        self._btn(btns, "退出全部", self.stop_all, RED)

        tk.Frame(root, bg=RULE, height=1).pack(fill="x", padx=20, pady=6)
        tk.Label(root, text="提示：面板右上角 🔓/🔒 可单独锁定\n"
                            "锁定后点击穿透，不挡游戏操作",
                 bg=BG, fg=GOLD2, font=self.f_s, justify="left").pack(anchor="w", padx=22)

        # 启动时先清一次超期截图（2 小时）
        try:
            n, b = cleanup.sweep()
            if n:
                print(f"启动清理：删除 {n} 个超期截图，释放 {b/1048576:.1f} MB")
        except Exception:
            pass

        self._tick()
        self.start_all()

    def _btn(self, parent, text, cmd, color):
        tk.Button(parent, text=text, command=cmd, bg=BG2, fg=color,
                  activebackground=BG2, relief="flat", bd=0, padx=10, pady=5,
                  font=self.f_s, cursor="hand2").pack(fill="x", pady=2)

    # ---------- 进程管理 ----------
    def _spawn(self, key, args, cwd):
        self._kill(key)
        logdir = os.path.join(HERE, "logs")
        os.makedirs(logdir, exist_ok=True)
        out = open(os.path.join(logdir, f"{key}-out.txt"), "a", encoding="utf-8", errors="replace")
        err = open(os.path.join(logdir, f"{key}-err.txt"), "a", encoding="utf-8", errors="replace")
        try:
            p = subprocess.Popen([PY, "-u"] + args, cwd=cwd,
                                 stdout=out, stderr=err,
                                 creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
            self.procs[key] = p
        except Exception as e:
            print(f"启动 {key} 失败: {e}")

    def _kill(self, key):
        p = self.procs.pop(key, None)
        if p and p.poll() is None:
            try:
                p.terminate()
                p.wait(timeout=3)
            except Exception:
                try:
                    p.kill()
                except Exception:
                    pass

    def start_all(self):
        self._spawn("overlay", [os.path.join(TOOLS, "overlay.py")], GAME)
        time.sleep(1.0)
        self._spawn("panel", [os.path.join(HERE, "panel_ui.py")], HERE)
        time.sleep(0.5)
        self._spawn("judge", [os.path.join(HERE, "watch_mem.py"),
                              "--timeout", "10800", "--delay", "1.5"], HERE)
        self._update_status()

    def restart_all(self):
        self.stop_all()
        time.sleep(1.0)
        self.start_all()

    def stop_all(self):
        for k in list(self.procs):
            self._kill(k)
        self._update_status()

    def _alive(self, key):
        p = self.procs.get(key)
        return bool(p and p.poll() is None)

    def _update_status(self):
        def mark(k, label):
            return f"{label}: {'运行中' if self._alive(k) else '已停止'}"
        self.status.config(text="\n".join([
            mark("overlay", "悬浮层"),
            mark("panel", "战绩面板"),
            mark("judge", "开战判定"),
        ]))

    def _tick(self):
        self._update_status()
        # 每 10 分钟清一次超过 2 小时的截图
        now = time.time()
        if now - getattr(self, "_last_sweep", 0) > 600:
            self._last_sweep = now
            try:
                n, b = cleanup.sweep()
                if n:
                    print(f"定时清理：删除 {n} 个超期截图，释放 {b/1048576:.1f} MB")
            except Exception:
                pass
        self.root.after(2000, self._tick)

    # ---------- 设置 ----------
    def open_settings(self):
        ov = load_json(OVERLAY_SET, DEFAULT_OVERLAY)
        pn = load_json(PANEL_SET, DEFAULT_PANEL)

        w = tk.Toplevel(self.root)
        w.title("设置")
        w.configure(bg=BG)
        w.geometry("380x430+120+120")
        w.transient(self.root)

        f_t = tkfont.Font(family="Microsoft YaHei UI", size=9, weight="bold")
        f_s = tkfont.Font(family="Microsoft YaHei UI", size=9)

        vars = {}

        def section(title):
            tk.Label(w, text=title, bg=BG, fg=GOLD, font=f_t,
                     anchor="w").pack(fill="x", padx=16, pady=(12, 2))
            tk.Frame(w, bg=RULE, height=1).pack(fill="x", padx=16)

        def slider(label, key, lo, hi, step, init, fmt="{:.2f}"):
            row = tk.Frame(w, bg=BG)
            row.pack(fill="x", padx=16, pady=3)
            tk.Label(row, text=label, bg=BG, fg=FG, font=f_s, width=14,
                     anchor="w").pack(side="left")
            v = tk.DoubleVar(value=float(init))
            vars[key] = v
            val = tk.Label(row, text=fmt.format(float(init)), bg=BG, fg=GOLD2,
                           font=f_s, width=6, anchor="e")
            val.pack(side="right")

            def on_change(*_a):
                val.config(text=fmt.format(v.get()))
            tk.Scale(row, from_=lo, to=hi, resolution=step, orient="horizontal",
                     variable=v, showvalue=False, bg=BG, fg=FG, troughcolor=BG2,
                     highlightthickness=0, bd=0, sliderrelief="flat",
                     command=lambda _x: on_change()).pack(side="left", fill="x",
                                                         expand=True, padx=6)
            return v

        def check(label, key, init):
            v = tk.BooleanVar(value=bool(init))
            vars[key] = v
            tk.Checkbutton(w, text=label, variable=v, bg=BG, fg=FG,
                           selectcolor=BG2, activebackground=BG,
                           activeforeground=FG, font=f_s,
                           highlightthickness=0).pack(anchor="w", padx=16, pady=2)
            return v

        section("悬浮层")
        slider("不透明度", "ov_alpha", 0.3, 1.0, 0.02, ov["alpha"], "{:.2f}")
        slider("缩放", "ov_scale", 0.8, 1.6, 0.05, ov["scale"], "{:.2f}")
        check("锁定（点击穿透）", "ov_locked", ov.get("locked", False))
        chk_ov_top = check("强制置顶（压在游戏之上）", "ov_top",
                           ov.get("forceTopmost", True))

        section("战绩面板")
        slider("不透明度", "pn_alpha", 0.3, 1.0, 0.02, pn["alpha"], "{:.2f}")
        slider("面板尺寸", "pn_scale", 0.6, 2.0, 0.05, pn.get("scale", 1.0), "{:.2f}")
        chk_pn_top = check("强制置顶（压在游戏之上）", "pn_top",
                           pn.get("force_topmost", True))
        check("锁定（点击穿透）", "pn_locked", pn.get("locked", False))

        # 主战者显示方式（三选一）
        row_h = tk.Frame(w, bg=BG)
        row_h.pack(fill="x", padx=16, pady=(6, 2))
        tk.Label(row_h, text="主战者显示", bg=BG, fg=FG, font=f_s,
                 width=14, anchor="w").pack(side="left")
        hv = tk.StringVar(value=pn.get("hero_display", "both"))
        vars["hero_display"] = hv
        for val, label in (("both", "头像+名字"), ("name", "仅名字"),
                           ("portrait", "仅头像")):
            tk.Radiobutton(row_h, text=label, variable=hv, value=val,
                           bg=BG, fg=DIM, selectcolor=BG2,
                           activebackground=BG, activeforeground=FG,
                           font=f_s, highlightthickness=0).pack(side="left")

        section("开战判定")
        slider("开战等待(秒)", "delay", 0.5, 3.0, 0.1, 1.5, "{:.1f}")
        check("只在开战时算一次（静态）", "static", True)

        def apply():
            ov["alpha"] = round(vars["ov_alpha"].get(), 2)
            ov["scale"] = round(vars["ov_scale"].get(), 2)
            ov["locked"] = bool(vars["ov_locked"].get())
            ov["mode"] = "static" if vars["static"].get() else "dynamic"
            ov["forceTopmost"] = bool(vars["ov_top"].get())
            save_json(OVERLAY_SET, ov)

            pn["alpha"] = round(vars["pn_alpha"].get(), 2)
            pn["scale"] = round(vars["pn_scale"].get(), 2)
            pn["locked"] = bool(vars["pn_locked"].get())
            pn["hero_display"] = vars["hero_display"].get()
            pn["force_topmost"] = bool(vars["pn_top"].get())
            save_json(PANEL_SET, pn)

            delay = round(vars["delay"].get(), 1)
            with open(os.path.join(HERE, "logs", "judge-delay.txt"), "w") as fh:
                fh.write(str(delay))

            w.destroy()
            self.restart_all()

        tk.Frame(w, bg=RULE, height=1).pack(fill="x", padx=16, pady=(10, 0))
        bar = tk.Frame(w, bg=BG)
        bar.pack(fill="x", padx=16, pady=8)
        tk.Button(bar, text="应用并重启", command=apply, bg=GOLD, fg="#1a1209",
                  relief="flat", bd=0, padx=12, pady=5, font=f_s,
                  cursor="hand2").pack(side="right")
        tk.Button(bar, text="取消", command=w.destroy, bg=BG2, fg=DIM,
                  relief="flat", bd=0, padx=12, pady=5, font=f_s,
                  cursor="hand2").pack(side="right", padx=6)

    def on_close(self):
        self.stop_all()
        self.root.destroy()


def main():
    root = tk.Tk()
    app = App(root)
    root.protocol("WM_DELETE_WINDOW", app.on_close)
    root.mainloop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
