#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
战绩面板（紧凑版）—— 只显示**你自己**的信息。

每场两行：
    第 N 把   时间   胜率   实掉X
    主战者  Lv等级 血X   阵容（星级/攻血）

顶部：开局时间、总场次、最终名次。
窗口固定 420×520，内容超出滚动，不会被内容撑大。
"""
import json
import os
import sys
import tkinter as tk
import tkinter.font as tkfont

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
HIST = os.path.join(HERE, "logs", "history.json")

BG = "#12161d"
BG2 = "#171c25"
FG = "#efe9dc"
GOLD = "#c9a86a"
GOLD2 = "#8d7a52"
DIM = "#9aa7a0"
RULE = "#2a3038"
GREEN = "#8fbf8a"
RED = "#c07b6b"

# ⚠️ Tk 的 geometry 用的是**逻辑像素**；本机 175% 缩放，
#    所以 420x520 逻辑 = 763x978 物理，看着太大。
#    改成 300x340 逻辑 ≈ 545x618 物理。
WIN_W, WIN_H = 300, 340


class Panel:
    def __init__(self, root):
        self.root = root
        self.last_sig = None
        root.title("影之幻境 · 战绩")
        root.configure(bg=BG)
        sw = root.winfo_screenwidth()
        root.geometry(f"{WIN_W}x{WIN_H}+{sw - WIN_W - 40}+80")
        root.minsize(240, 220)
        # ⚠️ Tk 默认会让子控件把窗口撑大，必须用固定尺寸容器 + 关闭传播
        self.wrap = tk.Frame(root, bg=BG, width=WIN_W, height=WIN_H)
        self.wrap.pack(fill="both", expand=True)
        self.wrap.pack_propagate(False)
        parent = self.wrap

        self.f_t = tkfont.Font(family="Microsoft YaHei UI", size=8, weight="bold")
        self.f_s = tkfont.Font(family="Microsoft YaHei UI", size=7)

        head = tk.Frame(parent, bg=BG)
        head.pack(fill="x", padx=10, pady=(8, 2))
        tk.Label(head, text="战  绩", bg=BG, fg=GOLD, font=self.f_t).pack(side="left")
        tk.Button(head, text="刷新", command=self.refresh, bg=BG2, fg=DIM,
                  relief="flat", bd=0, padx=6, font=self.f_s,
                  activebackground=BG2).pack(side="right")

        self.info = tk.Label(parent, text="", bg=BG, fg=GOLD2, anchor="w",
                             font=self.f_s, wraplength=WIN_W - 20, justify="left")
        self.info.pack(fill="x", padx=12)
        tk.Frame(parent, bg=RULE, height=1).pack(fill="x", padx=8, pady=(4, 0))

        wrap = tk.Frame(parent, bg=BG)
        wrap.pack(fill="both", expand=True, padx=8, pady=4)
        self.canvas = tk.Canvas(wrap, bg=BG, highlightthickness=0, width=WIN_W - 34)
        sb = tk.Scrollbar(wrap, orient="vertical", command=self.canvas.yview)
        self.body = tk.Frame(self.canvas, bg=BG)
        self.body.bind("<Configure>", lambda e: self.canvas.configure(
            scrollregion=self.canvas.bbox("all")))
        self.win = self.canvas.create_window((0, 0), window=self.body, anchor="nw")
        self.canvas.configure(yscrollcommand=sb.set)
        self.canvas.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")
        self.canvas.bind("<Configure>", lambda e: self.canvas.itemconfig(
            self.win, width=e.width))
        self.canvas.bind_all("<MouseWheel>",
                             lambda e: self.canvas.yview_scroll(int(-e.delta / 120), "units"))

        # 锁定窗口尺寸：建完所有控件后再强制设一次，
        # 否则 Tk 会按内容把窗口撑大（实测撑到 763x978）
        self.refresh()
        root.update_idletasks()
        root.geometry(f"{WIN_W}x{WIN_H}+{root.winfo_screenwidth()-WIN_W-40}+80")
        root.after(120, lambda: root.geometry(
            f"{WIN_W}x{WIN_H}+{root.winfo_screenwidth()-WIN_W-40}+80"))
        root.after(3000, self._tick)

    def _tick(self):
        self.refresh()
        self.root.after(3000, self._tick)

    def _load(self):
        try:
            with open(HIST, encoding="utf-8") as fh:
                return json.load(fh)
        except Exception:
            return {"records": []}

    def refresh(self):
        d = self._load()
        recs = d.get("records") or []
        sig = (len(recs), d.get("placement"),
               tuple(r.get("actual_me") for r in recs))
        if sig == self.last_sig:
            return
        self.last_sig = sig

        place = d.get("placement")
        parts = [f"开局 {d.get('session', '?')}", f"{len(recs)} 场"]
        parts.append(f"名次 第{place}名" if place else "名次 进行中")
        self.info.config(text="    ".join(parts))

        for w in self.body.winfo_children():
            w.destroy()

        if not recs:
            tk.Label(self.body, text="还没有记录，开一局试试喵",
                     bg=BG, fg=GOLD2, font=self.f_s).pack(pady=20)
            return
        for i, r in enumerate(recs, 1):
            self._row(i, r)

    def _row(self, idx, r):
        import history as HIS
        f = tk.Frame(self.body, bg=BG)
        f.pack(fill="x", pady=2)

        head = tk.Frame(f, bg=BG)
        head.pack(fill="x")
        win, loss = r.get("win", 0), r.get("loss", 0)
        col = GREEN if win >= 50 else (RED if loss >= 50 else DIM)
        tk.Label(head, text=f"第{idx}把", bg=BG, fg=GOLD,
                 font=self.f_t).pack(side="left")
        tk.Label(head, text=f" {r['t']}  胜{win}%", bg=BG, fg=col,
                 font=self.f_s).pack(side="left")
        if r.get("actual_me"):
            tk.Label(head, text=f" 实掉{r['actual_me']}", bg=BG, fg=DIM,
                     font=self.f_s).pack(side="left")

        name, prof = HIS.hero_name(r.get("me_hero") or 0)
        tag = name + (f"·{prof}" if prof else "")
        tk.Label(f, text=f"{tag}  Lv{r['me_lv']}  血{r['me_hp']}",
                 bg=BG, fg=FG, anchor="w", justify="left",
                 font=self.f_s).pack(fill="x")
        tk.Label(f, text=self._brief(r["me_board"]), bg=BG, fg=DIM,
                 anchor="w", justify="left", wraplength=WIN_W - 30,
                 font=self.f_s).pack(fill="x")

    @staticmethod
    def _brief(board, limit=5):
        items = [f"{c['star']}★{c['attack']}/{c['health']}" for c in board]
        if not items:
            return "阵容 （空）"
        extra = f" +{len(items)-limit}" if len(items) > limit else ""
        return "阵容 " + " ".join(items[:limit]) + extra


def main():
    root = tk.Tk()
    Panel(root)
    root.mainloop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
