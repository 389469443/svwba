  },
  "Ability_keyword_0002": {
   "id": "Ability_keyword_0002",
   "engineId": null,
   "text": "被破坏时发动的能力。",
   "isTitle": false
  },
  "Ability_keyword_0003": {
   "id": "Ability_keyword_0003",
   "engineId": null,
   "text": "使用进化点进化时，或使用超进化点超进化时发动的能力。",
   "isTitle": false
  },
  "Ability_keyword_0004": {
   "id": "Ability_keyword_0004",
   "engineId": null,
   "text": "攻击时，在造成伤害前发动的能力。",
   "isTitle": false
  },
  "Ability_keyword_0005": {
   "id": "Ability_keyword_0005",
   "engineId": "guard",
   "text": "对手的随从只能攻击拥有守护能力的随从。",
   "isTitle": false
  },
  "Ability_keyword_0006": {
   "id": "Ability_keyword_0006",
   "engineId": "rush",
   "text": "进入战场的回合就可以进行攻击。",
   "isTitle": false
  },
  "Ability_keyword_0007": {
   "id": "Ability_keyword_0007",
   "engineId": "stealth",
   "text": "不会被对手的能力选中，不会被对手的随从攻击。\n进行攻击或通过能力造成伤害时，失去潜行。",
   "isTitle": false
  },
  "Ability_keyword_0008": {
   "id": "Ability_keyword_0008",
   "engineId": "destroy",
   "text": "通过交战对对手的随从造成伤害后，无视剩余生命值直接破坏对手的随从。",
   "isTitle": false
  },
  "Ability_keyword_0009": {
   "id": "Ability_keyword_0009",
   "engineId": "drain",
   "text": "通过攻击造成伤害时，回复自己的主战者与造成的伤害等量的生命值。",
   "isTitle": false
  },
  "Ability_keyword_0010": {
   "id": "Ability_keyword_0010",
   "engineId": null,
   "text": "指“自己的能量点最大值为7或以上”的状态。",
   "isTitle": false
  },
  "Ability_keyword_0012": {
   "id": "Ability_keyword_0012",
   "engineId": null,
   "text": "使用法术或产生魔力增幅时于手牌中发动的能力。",
   "isTitle": false
  },
  "Ability_keyword_0013": {
   "id": "Ability_keyword_0013",
   "engineId": null,
   "text": "自己的回合开始时，倒计数-1。\n当倒计数变为0时，会被破坏。",
   "isTitle": false
  },
  "Ability_keyword_0014": {
   "id": "Ability_keyword_0014",
   "engineId": null,
   "text": "自己的墓场为指定值或以上时，消耗该数值而发动的能力。",
   "isTitle": false
  },
  "Ability_keyword_0015": {
   "id": "Ability_keyword_0015",
   "engineId": null,
   "text": "若自己的战场上的土之印数量为指定值或以上，则消耗该数值而发动的能力。",
   "isTitle": false
  },
  "Ability_keyword_0016": {
   "id": "Ability_keyword_0016",
   "engineId": "rushFollower",
   "text": "进入战场的回合就可以攻击随从。",
   "isTitle": false
  },
  "Ability_keyword_0017": {
   "id": "Ability_keyword_0017",
   "engineId": null,
   "text": "交战时，在互相造成伤害前发动的能力。",
   "isTitle": false
  },
  "Ability_keyword_0018": {
   "id": "Ability_keyword_0018",
   "engineId": null,
   "text": "若剩余的能量点为指定值或以上，则从手牌中使用时，会消耗该数值的能量点代替原始费用来发动能力。",
   "isTitle": false
  },
  "Ability_keyword_0019": {
   "id": "Ability_keyword_0019",
   "engineId": null,
   "text": "召唤1张本次对战中被破坏的，原始费用为指定值或以下且数值最大的自己的随从进入战场的能力。\n因本能力而进入战场的随从追加获得亡者类型。",
   "isTitle": false
  },
  "Ability_keyword_0022": {
   "id": "Ability_keyword_0022",
   "engineId": null,
   "text": "在剩余的能量点不足以使用本卡牌时，可以消耗激奏费用作为法术来使用的能力。",
   "isTitle": false
  },
  "Ability_keyword_0023": {
   "id": "Ability_keyword_0023",
   "engineId": null,
   "text": "从牌组直接进入战场的能力。\n每次进入战场的卡牌仅限每种1张。",
   "isTitle": false
  },
  "Ability_keyword_0024": {
   "id": "Ability_keyword_0024",
   "engineId": null,
   "text": "在剩余的能量点不足以使用本卡牌时，可以消耗结晶费用作为护符来使用的能力。",
   "isTitle": false
  },
  "Ability_keyword_0025": {
   "id": "Ability_keyword_0025",
   "engineId": null,
   "text": "在手牌中时，1回合1次，将手牌中的指定卡牌作为素材来融合的能力。",
   "isTitle": false
  },
  "Ability_keyword_0026": {
   "id": "Ability_keyword_0026",
   "engineId": null,
   "text": "指“本次对战中进入战场的自己的随从数”。\n部分能力需要本数值为指定值或以上时才会发动。",
   "isTitle": false
  },
  "Ability_keyword_0027": {
   "id": "Ability_keyword_0027",
   "engineId": null,
   "text": "自己的战场上的土之印数量会被累计。\n土之印会因土之秘术而被消耗。\n土之印不会被能力破坏，不会被对手的能力选中。",
   "isTitle": false
  },
  "Ability_keyword_0029": {
   "id": "Ability_keyword_0029",
   "engineId": null,
   "text": "指“本回合中自己使用的卡牌张数”。\n部分能力需要本数值为指定值或以上时才会发动。",
   "isTitle": false
  },
  "Ability_keyword_0030": {
   "id": "Ability_keyword_0030",
   "engineId": "cannotBeAttacked",
   "text": "不会被对手的随从攻击。",
   "isTitle": false
  },
  "Ability_keyword_0031": {
   "id": "Ability_keyword_0031",
   "engineId": "cannotBeTargeted",
   "text": "不会被对手的能力选中。",
   "isTitle": false
  },
  "Ability_keyword_0032": {
   "id": "Ability_keyword_0032",
   "engineId": "ward",
   "text": "使受到的伤害变为0。之后，失去屏障。",
   "isTitle": false
  },
  "Ability_keyword_0033": {
   "id": "Ability_keyword_0033",
   "engineId": null,
   "text": "使用超进化点而超进化时发动的能力。",
   "isTitle": false
  },
  "Ability_keyword_0034": {
   "id": "Ability_keyword_0034",
   "engineId": null,
   "text": "从多个能力中选择指定数量的能力并发动的能力。",
   "isTitle": false
  },
  "Ability_keyword_0035": {
   "id": "Ability_keyword_0035",
   "engineId": null,
   "text": "每回合仅限1次，按下启动按钮才会发动的能力。\n若启动前标有指定费用，则会消耗该数值的能量点。",
   "isTitle": false
  },
  "Ability_keyword_0036": {
   "id": "Ability_keyword_0036",
   "engineId": null,
   "text": "将被放置于战场以外的特殊区域。\n最多可以放置5个，无法重复放置同名纹章。",
   "isTitle": false
  },
  "Ability_keyword_0038": {
   "id": "Ability_keyword_0038",
   "engineId": null,
   "text": "由10张强力的深渊之主关联卡牌所组成的牌组。",
   "isTitle": false
  },
  "Ability_keyword_0039": {
   "id": "Ability_keyword_0039",
   "engineId": null,
   "text": "将拥有信仰的卡牌加入牌组后，\n对战开始时，将被放置于战场以外的特殊区域。\n最多可以放置5个，无法重复放置同名信仰。\n拥有名为信仰值的固有数值。",
   "isTitle": false
  },
  "Ability_keyword_0040": {
   "id": "Ability_keyword_0040",
   "engineId": null,
   "text": "由76张不同的《灾杰的继承者》的卡牌所组成的牌组。",
   "isTitle": false
  },
  "Ability_keyword_0041": {
   "id": "Ability_keyword_0041",
   "engineId": null,
   "text": "奥义槽为10或以上时发动的能力。\n奥义槽是指“现在的回合数”和“在手牌中时自己的随从的进化次数”的合计。",
   "isTitle": false
  },
  "Ability_keyword_0042": {
   "id": "Ability_keyword_0042",
   "engineId": null,
   "text": "奥义槽为15或以上时发动的能力。\n奥义槽是指“现在的回合数”和“在手牌中时自己的随从的进化次数”的合计。",
   "isTitle": false
  },
  "Ability_keyword_0043": {
   "id": "Ability_keyword_0043",
   "engineId": null,
   "text": "温柔地摸摸小狗的行为。\n重要的是要充满爱意。",
   "isTitle": false
  },
  "Ability_keyword_0044": {
